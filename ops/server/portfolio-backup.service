[Unit]
Description=Back up portfolio Git repositories and persistent data
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=work
Group=work
UMask=0077
ExecStart=/home/work/bin/backup-portfolios.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
